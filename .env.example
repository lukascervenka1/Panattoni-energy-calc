# Published-to-web CSV links from your Google Sheet (see README.md for setup).
# Leave unset to run entirely on the bundled fallback data in /data.
SHEETS_BUILDINGS_CSV_URL=
SHEETS_CONFIG_CSV_URL=

# Production domain, used to build absolute URLs for the link preview card
# (Open Graph). On Vercel this falls back to the deployment URL automatically,
# so set it only once you have the final domain.
SITE_URL=
